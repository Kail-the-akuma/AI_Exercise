* text=auto

*.cs      text diff=csharp
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.props   text
*.targets text
*.json    text
*.md      text
*.cshtml  text
*.ps1     text eol=crlf
*.sh      text eol=lf

*.db   binary
*.png  binary
*.jpg  binary
*.pfx  binary

# text=auto detects these correctly on its own today. They are named anyway, because a
# font file silently rewritten by an end of line conversion is not a file that fails to
# load, it is a file that loads as nothing while every tool reports success.
*.woff2 binary
*.woff  binary

# The licence beside the fonts is quoted material, not our prose. It is stored with the
# line endings SIL publishes it with, so that it can be compared against the original by
# anybody who doubts it. Left to `* text=auto` it would be rewritten on checkout, and a
# licence text that no longer matches its source is one somebody has to verify again from
# nothing.
src/IdeaBoard.App/wwwroot/fonts/OFL.txt text eol=lf
