@model string
@{
    // The icons of the navigation rail, drawn here rather than pulled from a font or a
    // library. An icon font is a request to somewhere else and a dependency to keep, and
    // a letter or an emoji standing in for an icon is not an icon system, it is whatever
    // the reader's platform happens to draw that day.
    //
    // All four share one geometry: a 20 by 20 box, a 1.75 stroke, round caps, and no
    // fill. They take their colour from the text around them, so the rail's white, the
    // active item's white and a hover all carry the icon with them without a second rule.
    //
    // Hidden from assistive technology, because the word beside each one says the same
    // thing and says it better. The word is still in the markup when the rail is closed;
    // it is the stylesheet that fades it, not this.

    string drawing = string.Empty;

    switch (Model)
    {
        case "ranking":
        {
            // Four bars of rising height: an order, which is what the tab is.
            drawing = "<path d=\"M3.5 14.5v-3M8 14.5V9m4.5 5.5V6.5M17 14.5v-9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\"/>";
            break;
        }

        case "recent":
        {
            drawing = "<circle cx=\"10\" cy=\"10\" r=\"7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"/><path d=\"M10 6v4.3l2.8 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>";
            break;
        }

        case "person":
        {
            drawing = "<circle cx=\"10\" cy=\"6.75\" r=\"3.1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"/><path d=\"M3.9 16.6c0-2.9 2.7-4.6 6.1-4.6s6.1 1.7 6.1 4.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\"/>";
            break;
        }

        case "plus":
        {
            drawing = "<path d=\"M10 4.2v11.6M4.2 10h11.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\"/>";
            break;
        }

        default:
        {
            // An unknown name draws nothing rather than a box with a question mark. A
            // missing icon beside a word that is still there reads as a plain link.
            drawing = string.Empty;
            break;
        }
    }
}
@if (drawing.Length > 0)
{
    <svg class="icone" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">@Html.Raw(drawing)</svg>
}
