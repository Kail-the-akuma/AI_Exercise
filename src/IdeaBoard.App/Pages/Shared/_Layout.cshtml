@inject ISignedInDisplayName signedInDisplayName
@inject INewVoteNotices newVoteNotices
@{
    // The active tab is worked out from the path rather than from a flag each page sets,
    // so that a new page cannot forget to declare it and silently light up both tabs.
    string currentPath = Context.Request.Path.Value ?? "/";

    string? rankingCurrent = null;
    string? recentCurrent = null;

    if (string.Equals(currentPath, "/", StringComparison.OrdinalIgnoreCase))
    {
        rankingCurrent = "page";
    }

    if (string.Equals(currentPath, "/recentes", StringComparison.OrdinalIgnoreCase))
    {
        recentCurrent = "page";
    }

    string? personalCurrent = null;

    if (string.Equals(currentPath, "/pessoal", StringComparison.OrdinalIgnoreCase))
    {
        personalCurrent = "page";
    }

    // Null on the two pages that exist before somebody has a row: the one that asks them to
    // register a name, and the error page. The layout is drawn on both, so it asks the
    // question that is allowed to come back empty rather than the one that refuses to.
    string? signedInName = await signedInDisplayName.TryGetAsync(Context.RequestAborted);

    // Empty for the same people the name is empty for, and for everybody with nothing new.
    NewVoteNotice newVotes = await newVoteNotices.ReadAsync(Context.RequestAborted);

    // The document title carries only the page name. There is deliberately no product
    // name anywhere in this layout: choosing one is a human decision that is still open,
    // and a placeholder in the interface would close it by simply being there long enough.
    string documentTitle = string.Empty;

    if (ViewData["Title"] is string pageTitle && pageTitle.Length > 0)
    {
        documentTitle = pageTitle;
    }
}
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@documentTitle</title>
    <link rel="stylesheet" href="~/_content/IdeaBoard.App/css/site.css" />
</head>
<body>
    <header class="cabecalho">
        <nav class="navegacao" aria-label="Navegação principal">
            <ul class="separadores">
                <li>
                    <a asp-page="/Index" aria-current="@rankingCurrent">@UiText.RankingTab</a>
                </li>
                <li>
                    <a asp-page="/Recentes" aria-current="@recentCurrent">@UiText.RecentTab</a>
                </li>
                <li>
                    <a asp-page="/Pessoal" aria-current="@personalCurrent">
                        @UiText.PersonalTab

                        @*
                            The notice lives on the way in to the page that clears it, which
                            is what makes it honest: it goes away because somebody went and
                            looked, and not because time passed.

                            The number is spoken as a whole sentence rather than as a bare
                            digit beside a link, because "3" read out after the name of a
                            tab says nothing about what three is.
                        *@
                        @*
                            Said twice, and the reason the sentence stayed is the one
                            written above it: a bare digit beside the name of a tab says
                            nothing about what the digit counts.

                            So the sentence is what a screen reader gets, in full, and the
                            eye gets the number. Written the other way round the sentence
                            lands inside a pill fifteen rem wide and breaks over three
                            lines, and a notice that makes the navigation worse is a
                            notice people learn to ignore.
                        *@
                        @if (newVotes.HasAnything)
                        {
                            <span class="aviso-novos" aria-hidden="true">@newVotes.IdeaCount</span>
                            <span class="so-leitor">@UiText.FormatIdeasWithNewVotes(newVotes.IdeaCount)</span>
                        }
                    </a>
                </li>
            </ul>

            @*
                Secondary, and on every page, because the empty list has to carry a
                prominent one of its own by Docs/02 and two of them side by side is one
                too many. The header is the one that gives way: this is the way back to
                the form from anywhere, not the invitation to use it.
            *@
            <a class="botao" asp-page="/Nova">@UiText.SubmitIdeaButton</a>

            @*
                Who you are signed in as. Only the name is available here, and that is on
                purpose: the row behind it also carries the account name, which the data
                model says is never rendered in the interface, and a layout that could reach
                it would be one edit away from showing it.
            *@
            @if (signedInName is not null)
            {
                <p class="identificacao">
                    <partial name="_Iniciais" model="@signedInName" />
                    <span class="identificacao-nome">@signedInName</span>
                </p>
            }
        </nav>
    </header>

    <main class="conteudo">
        @RenderBody()
    </main>

    <script src="~/_content/IdeaBoard.App/js/vote.js" defer></script>
</body>
</html>
