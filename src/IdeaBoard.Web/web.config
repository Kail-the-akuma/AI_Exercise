<?xml version="1.0" encoding="utf-8"?>
<!--
  The site configuration the published host is served under.

  This file carries the only part of authentication that does not live in code any more,
  and that is the reason it is tracked here rather than left to whoever sets up the site.
  The application cannot read these settings at startup, so it cannot refuse to start when
  they are wrong: the startup guard that used to check sign-in configuration was removed
  for exactly that reason, and this file plus the manual verification list is what took its
  place.

  ANONYMOUS AUTHENTICATION BEING LEFT ON IS THE FAILURE THAT MATTERS. With it enabled the
  server lets unidentified requests through to the application, and nothing in the
  application notices, because a request that arrives without an identity looks the same as
  one whose identity has not been read yet. It is set to false here, explicitly, rather
  than left to a default.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!-- In process, so that the identity the server negotiated reaches the application
           on the same request rather than through a second hop. -->
      <aspNetCore processPath="dotnet"
                  arguments=".\IdeaBoard.Web.dll"
                  stdoutLogEnabled="false"
                  hostingModel="inprocess" />

      <security>
        <authentication>
          <windowsAuthentication enabled="true" />
          <anonymousAuthentication enabled="false" />
        </authentication>
      </security>
    </system.webServer>
  </location>
</configuration>
