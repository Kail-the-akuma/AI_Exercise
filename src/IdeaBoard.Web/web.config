<?xml version="1.0" encoding="utf-8"?>
<!--
  The site configuration the published host is served under.

  This file carries the only part of authentication that does not live in code any more,
  and that is the reason it is tracked here rather than left to whoever sets up the site.
  The application cannot read these settings at startup, so it cannot refuse to start when
  they are wrong: the startup guard that used to check sign-in configuration was removed
  for exactly that reason, and this file plus the manual verification list is what took its
  place.

  ANONYMOUS AUTHENTICATION BEING LEFT ON IS THE FAILURE THAT MATTERS. With it enabled the
  server lets unidentified requests through to the application, and nothing in the
  application notices, because a request that arrives without an identity looks the same as
  one whose identity has not been read yet. It is set to false here, explicitly, rather
  than left to a default.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!-- In process, so that the identity the server negotiated reaches the application
           on the same request rather than through a second hop. -->
      <aspNetCore processPath="dotnet"
                  arguments=".\IdeaBoard.Web.dll"
                  stdoutLogEnabled="false"
                  hostingModel="inprocess">

        <!--
          THE TWO VALUES THE APPLICATION REFUSES TO START WITHOUT, and they live here
          because every other place to put them is worse.

          The published appsettings.json carries both as empty strings on purpose, so the
          host has nothing to fall back on: it stops at startup and names the missing key
          rather than running wrong. That guard only helps if somebody knows where to
          supply the values, which is why they are written down rather than left to the
          person setting up the site.

          NOT an appsettings.Production.json beside the application. That folder is
          emptied by the next publish, which is the same failure this repository already
          documents for a database kept there, and the symptom is a site that stops
          starting for a reason that does not look like the cause.

          Here they travel with the artefact, survive every publish, and change through a
          pull request like everything else. They are paths on an internal server, not
          secrets: no credential belongs in this file, and none is needed, because the
          database is a file and identity comes from the web server.

          BOTH NAMES MUST BE SET IN EXACTLY ONE PLACE. The module's documentation warns
          that a variable also present in the system environment can be combined with the
          value set here, and that the result can stop the application from starting. Set
          these on the machine or on the application pool as well and the failure arrives
          looking like a bad connection string.

          The double underscore is how configuration sections are spelled in an
          environment variable: ConnectionStrings__IdeaBoard is the key
          'ConnectionStrings:IdeaBoard' the startup guard asks for by name.
        -->
        <environmentVariables>
          <environmentVariable name="ConnectionStrings__IdeaBoard"
                               value="Data Source=C:\IdeaBoard\data\ideaboard.db;Foreign Keys=True;Default Timeout=30" />
          <environmentVariable name="DataProtection__KeysPath"
                               value="C:\IdeaBoard\keys" />
        </environmentVariables>

      </aspNetCore>

      <security>
        <authentication>
          <windowsAuthentication enabled="true" />
          <anonymousAuthentication enabled="false" />
        </authentication>
      </security>
    </system.webServer>
  </location>
</configuration>
