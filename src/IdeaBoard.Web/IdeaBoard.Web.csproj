<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IdeaBoard.Web</RootNamespace>
    <AssemblyName>IdeaBoard.Web</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- pt-PT formatting and the Europe/Lisbon time zone both need the full ICU data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Logging.EventLog is not referenced: it ships in the shared
         framework, and NuGet refuses an explicit reference to it. -->
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.16.1" />

    <!-- Microsoft.Identity.Web 4.16.1 brings System.Security.Cryptography.Pkcs 10.0.10,
         which carries a known high severity advisory, GHSA-846f-f764-76mx, and a moderate
         one, GHSA-2fmv-rv2c-59x7. Pinned forward to the patched patch level. This is a
         direct reference only to raise a transitive version, and it can be removed once
         Microsoft.Identity.Web itself moves past the affected range. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <!-- This project references IdeaBoard.App and nothing else. The single reference is the
       safeguard that keeps any local identity code out of what gets published. -->
  <ItemGroup>
    <ProjectReference Include="..\IdeaBoard.App\IdeaBoard.App.csproj" />
  </ItemGroup>

</Project>
