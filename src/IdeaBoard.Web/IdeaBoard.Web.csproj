<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IdeaBoard.Web</RootNamespace>
    <AssemblyName>IdeaBoard.Web</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- pt-PT formatting and the Europe/Lisbon time zone both need the full ICU data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Logging.EventLog is not referenced: it ships in the shared
         framework, and NuGet refuses an explicit reference to it.

         There is no sign-in package either, and that is the change rather than an
         omission. Identity comes from the web server, so there is no library to bring in,
         no authority to reach and nothing to pin forward: the two security advisories that
         had to be worked around here came in through the federated sign-in library and
         left with it. -->
  </ItemGroup>

  <!-- This project references IdeaBoard.App and nothing else. The single reference is the
       safeguard that keeps any local identity code out of what gets published. -->
  <ItemGroup>
    <ProjectReference Include="..\IdeaBoard.App\IdeaBoard.App.csproj" />
  </ItemGroup>

</Project>
