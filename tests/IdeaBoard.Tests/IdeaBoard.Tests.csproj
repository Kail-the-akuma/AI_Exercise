<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IdeaBoard.Tests</RootNamespace>
    <AssemblyName>IdeaBoard.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--
      A floor on how many tests must actually run.

      The test platform's default zero-test policy counts SKIPPED tests as having run, so a
      suite where every test ended up skipped reports success with exit code 0: green, and
      nothing exercised. One miswritten condition attribute, or a fixture that fails in a
      way that skips instead of failing, is enough.

      The number is a floor and not the exact count, kept close to the real one. A generous
      floor would let a partial collapse through, which is the thing this exists to catch.
    -->
    <TestingPlatformCommandLineArguments>--minimum-expected-tests 120</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />

    <!-- Reaching IdeaBoard.Web pulls Microsoft.Identity.Web's dependency on
         System.Security.Cryptography.Xml 10.0.10, which carries three known high severity
         advisories, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj and GHSA-r955-8q5j-3h83.
         The web SDK prunes this package to the shared framework and this SDK does not, so
         the pin has to live here. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unit and integration tests exercise Domain, Data and Services, which live in the
         library. Going through a host to reach them would only be transitive luck. -->
    <ProjectReference Include="..\..\src\IdeaBoard.App\IdeaBoard.App.csproj" />

    <!-- Referenced only so one test can start the published host in process and prove the
         service graph composes. Nothing else in this project reaches through it. -->
    <ProjectReference Include="..\..\src\IdeaBoard.Web\IdeaBoard.Web.csproj" />
  </ItemGroup>

</Project>
