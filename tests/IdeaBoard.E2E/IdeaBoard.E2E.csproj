<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IdeaBoard.E2E</RootNamespace>
    <AssemblyName>IdeaBoard.E2E</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--
      A floor on how many tests must actually run, for the same reason it exists in
      IdeaBoard.Tests: the platform's default zero-test policy counts skipped tests as
      having run, so a suite where everything ended up skipped reports success with exit
      code 0.

      This floor is raised as scenarios land. It is deliberately the real count while the
      suite is this small, because with a handful of scenarios a generous floor would let
      most of them disappear without anyone noticing.
    -->
    <TestingPlatformCommandLineArguments>--minimum-expected-tests 16</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IdeaBoard.Local\IdeaBoard.Local.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Microsoft.Playwright.Xunit.v3" Version="1.64.1" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
